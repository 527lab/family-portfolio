---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { site } from '../data/site';
import { listPublic } from '../server/works';
const featured = listPublic({ featured: true });
---
<Base>
  <section class="hero">
    <h1>{site.title}</h1>
    <p>{site.tagline}</p>
  </section>
  <section>
    <h2>精選作品</h2>
    <Gallery works={featured} />
  </section>
</Base>
