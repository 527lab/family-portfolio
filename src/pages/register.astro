---
import Base from '../layouts/Base.astro';
import { AuthError, register } from '../server/auth';
import { config } from '../server/config';
import { clientIp } from '../server/http';

if (Astro.locals.user) return Astro.redirect('/studio/');
const mode = config().registration;
let error = '';
let done: 'active' | 'pending' | null = null;
const v = { username: '', displayName: '' };
if (mode !== 'closed' && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  v.username = String(form.get('username') ?? '').trim();
  v.displayName = String(form.get('display_name') ?? '').trim();
  const pw = String(form.get('password') ?? '');
  try {
    if (pw !== String(form.get('password2') ?? '')) throw new AuthError('兩次輸入的密碼不一樣');
    const u = await register({ ...v, password: pw, inviteCode: String(form.get('invite') ?? '') }, clientIp(Astro.request, Astro.clientAddress));
    done = u.status === 'pending' ? 'pending' : 'active';
  } catch (e) {
    if (!(e instanceof AuthError)) throw e;
    error = e.message;
    Astro.response.status = 400;
  }
}
---
<Base title="創作者註冊">
  <h1>創作者註冊</h1>
  {mode === 'closed' && <p>目前不開放註冊。需要帳號請聯絡管理員。</p>}
  {mode !== 'closed' && done === 'active' && <p class="ok" role="status">註冊完成！<a href="/login/">前往登入</a></p>}
  {mode !== 'closed' && done === 'pending' && <p class="ok" role="status">已送出申請。管理員核准後就可以登入。</p>}
  {mode !== 'closed' && !done && (
    <>
      <p>{mode === 'invite' ? '需要管理員給你的邀請碼。' : '送出後需要管理員核准才能登入。'}請使用暱稱，不要填真實姓名。</p>
      {error && <p class="error" role="alert">{error}</p>}
      <form method="post" class="form narrow">
        {mode === 'invite' && <label>邀請碼<input name="invite" required autocomplete="off" maxlength="40" /></label>}
        <label>帳號（英數字與底線，3–20 字）<input name="username" value={v.username} required maxlength="20" autocomplete="username" /></label>
        <label>暱稱（必填，會顯示在網站上，之後可修改）<input name="display_name" value={v.displayName} required maxlength="20" /></label>
        <label>密碼（至少 10 字元）<input type="password" name="password" required minlength="10" maxlength="128" autocomplete="new-password" /></label>
        <label>再輸入一次密碼<input type="password" name="password2" required minlength="10" maxlength="128" autocomplete="new-password" /></label>
        <button type="submit">註冊</button>
      </form>
    </>
  )}
</Base>
