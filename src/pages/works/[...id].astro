---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { categoryInfo } from '../../data/site';
import { getWorks } from '../../lib';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { id: work.id }, props: { work } }));
}
const { work } = Astro.props;
const d = work.data;
const info = categoryInfo[d.category];
const { Content } = await render(work);
const facts = [
  ['類別', info.label], ['年份', `${d.date.getFullYear()}`], ['媒材', d.medium], ['尺寸', d.size],
  ['地點', d.location], ['器材', d.camera], ['作曲家', d.composer], ['場合', d.event], ['成績', d.result],
].filter(([, v]) => v);
---
<Base title={d.title} description={d.summary}>
  <p><a href={info.path}>← 回到{info.label}</a></p>
  <h1>{d.title}</h1>
  {d.video?.type === 'file' && (
    <video controls preload="metadata" playsinline class="media">
      <source src={`/videos/${d.video.src}`} />
      您的瀏覽器不支援影片播放。
    </video>
  )}
  {d.video?.type === 'youtube' && (
    <div class="media embed">
      <iframe src={`https://www.youtube-nocookie.com/embed/${d.video.id}`} title={d.title} loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
  )}
  {!d.video && <Image class="media" src={d.cover} alt={d.coverAlt} widths={[800, 1200, 1600]} sizes="(min-width: 900px) 900px, 100vw" />}
  <dl class="facts">{facts.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
  <article class="prose"><Content /></article>
</Base>
