---
import { site, siteTitle } from '../data/site';
import { getSiteOwnerName } from '../server/auth';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string | null }
const { title, description = site.tagline, image } = Astro.props;
const owner = getSiteOwnerName();
const fullTitle = title ? `${title}｜${siteTitle(owner)}` : siteTitle(owner);
const path = Astro.url.pathname;
const user = Astro.locals.user;
const isPrivatePath = /^\/(studio|login|register|logout)(\/|$)/.test(path);
const ogImage = image ? new URL(image, Astro.url).href : undefined;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={siteTitle(owner)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {(site.noindex || isPrivatePath) && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <header class="site-header">
      <a class="brand" href="/">{owner}</a>
      <nav aria-label="主選單">
        {site.nav.map((n) => <a href={n.href} aria-current={path.replace(/\/?$/, '/') === n.href ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      © {new Date().getFullYear()} {owner} ・
      {user
        ? <><a href="/studio/">創作者後台（{user.displayName}）</a></>
        : <a href="/login/">創作者登入</a>}
    </footer>
  </body>
</html>
