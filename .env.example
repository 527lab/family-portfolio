# 複製成 .env 後填寫（.env 已被 .gitignore 排除，請勿提交）
TUNNEL_TOKEN=
# true = 不讓搜尋引擎收錄（預設）；公開前改 false，重啟容器即可（執行期讀取）
NOINDEX=true
# 對外網址。會寫進建置結果，修改後需重新 build（docker compose up -d --build）
SITE_URL=https://portfolio.example.com

# 註冊模式：closed 關閉 ｜ invite 需管理員給的邀請碼（預設）｜ approval 任何人可申請、管理員核准後才能登入
REGISTRATION=invite
# 上傳大小上限（MB）。較大的影片請用 YouTube 不公開連結
MAX_IMAGE_MB=15
MAX_VIDEO_MB=200
# 經 Cloudflare Tunnel 時設 true，登入限流才會用 CF-Connecting-IP；直連時務必維持 false
TRUST_PROXY=true
