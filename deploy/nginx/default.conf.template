# nginx 反向代理設定樣板。官方映像檔啟動時會把 ${MAX_VIDEO_MB}、${NOINDEX} 代入，輸出到 /etc/nginx/conf.d/default.conf
# （只代入 NGINX_ENVSUBST_FILTER 指定的變數，nginx 自己的 $host 等變數不受影響）。

# 私人頁面（後台、登入、註冊、登出）：不論 NOINDEX 為何，一律不讓搜尋引擎收錄
map $uri $private_path {
    default 0;
    ~^/(studio|login|register|logout)(/|$) 1;
}

# NOINDEX=true（預設）時，所有回應（含圖片、影片）都帶 X-Robots-Tag；改成 false 只放行公開內容，私人頁面仍 noindex
map "${NOINDEX}:$private_path" $robots_header {
    default "noindex, nofollow, noarchive";
    "false:0" "";
}

# 依請求決定 Connection 標頭（CF-Connecting-IP 等其他標頭預設就會原樣轉給網站，登入限流用）
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# 有上游（Cloudflare Tunnel）傳來的協定就沿用，沒有（本機直連）就用 nginx 自己看到的
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    # 上傳大小上限對應 MAX_VIDEO_MB（網站程式內還會依圖片／影片各自檢查一次）
    client_max_body_size ${MAX_VIDEO_MB}m;
    client_body_timeout 120s;

    add_header X-Robots-Tag $robots_header always;

    location / {
        proxy_pass http://web:4321;
        # 網站也會送 X-Robots-Tag；以 nginx 為準，避免重複標頭
        proxy_hide_header X-Robots-Tag;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;   # 含 port，網站的 Origin 檢查才對得上（本機 localhost:8080）
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # 經 Cloudflare Tunnel 時，原本的協定在 Cloudflare 那一層，沿用它傳來的值
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # 大檔上傳直接串流給網站，不先寫進 nginx 暫存
        proxy_request_buffering off;
        # 網站自己回應的安全標頭（CSP 等）原樣保留
    }

    # 圖片與影片：不緩衝，讓影片可以邊下載邊播；Range 與 If-Range 轉給網站處理（拖曳進度條、手機播放需要）
    location /media/ {
        proxy_pass http://web:4321;
        # 網站也會送 X-Robots-Tag；以 nginx 為準，避免重複標頭
        proxy_hide_header X-Robots-Tag;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;   # 含 port，網站的 Origin 檢查才對得上（本機 localhost:8080）
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
